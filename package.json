{
  "name": "pleniora-ai-manager-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-capable Pleniora AI desktop package",
  "engines": {
    "node": ">=20"
  },
  "main": "desktop-main.cjs",
  "scripts": {
    "dist:windows": "electron-builder --win nsis zip",
    "mobile:build": "node scripts/build-mobile-web.cjs",
    "mobile:sync": "node scripts/sync-capacitor.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pleniora.ai.manager",
    "productName": "Pleniora AI",
    "asar": true,
    "files": [
      "desktop-main.cjs",
      "server.js",
      "*.html",
      "*.webmanifest",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "!data/**/*",
      "!README.txt",
      "!*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "dependencies": {
    "nodemailer": "^10.3.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
